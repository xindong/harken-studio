{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "schemaVersion": {
      "type": "integer"
    },
    "guid": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "guid": {
          "$ref": "#/$defs/guid"
        }
      },
      "required": [
        "name",
        "guid"
      ]
    },
    "waveform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "soundGuid": {
          "$ref": "#/$defs/guid"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.+\\.vkd$"
        },
        "trimStartFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740992
        },
        "trimEndFrame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740992
        }
      },
      "required": [
        "soundGuid",
        "file",
        "trimStartFrame",
        "trimEndFrame"
      ]
    },
    "packMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packStableId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "guid": {
                "$ref": "#/$defs/guid"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "Action",
                  "Sound",
                  "Container",
                  "Track",
                  "Segment",
                  "Layer",
                  "Variable",
                  "Attenuation",
                  "Bus"
                ]
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "guid",
              "name",
              "type",
              "path"
            ]
          }
        }
      },
      "required": [
        "packStableId",
        "platform",
        "language",
        "objects"
      ]
    },
    "projectData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "projectGuid": {
          "$ref": "#/$defs/guid"
        },
        "projectName": {
          "type": "string",
          "minLength": 1
        },
        "studioVersion": {
          "type": "string",
          "minLength": 1
        },
        "studioSchemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "guid": {
                "$ref": "#/$defs/guid"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "basePlatform": {
                "type": "string",
                "enum": [
                  "Windows",
                  "macOS",
                  "Linux",
                  "Android",
                  "iOS"
                ]
              }
            },
            "required": [
              "guid",
              "name",
              "basePlatform"
            ]
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![Ss][Ff][Xx]$).+$"
          }
        }
      },
      "required": [
        "schemaVersion",
        "projectGuid",
        "projectName",
        "studioVersion",
        "studioSchemaVersion",
        "platforms",
        "languages"
      ]
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "guid": {
          "$ref": "#/$defs/guid"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      },
      "required": [
        "name",
        "guid",
        "labels"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/projectData"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "guid": {
          "$ref": "#/$defs/guid"
        },
        "waveforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waveform"
          }
        },
        "metadata": {
          "$ref": "#/$defs/packMetadata"
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "guid"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          }
        },
        "waveforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waveform"
          }
        },
        "metadata": {
          "$ref": "#/$defs/packMetadata"
        }
      },
      "required": [
        "schemaVersion",
        "variables"
      ]
    }
  ],
  "x-harken-format": {
    "classification": "derived",
    "formatId": "generated.pack-companion",
    "pathPatterns": [
      "Project.json",
      "**/Init.json",
      "**/*.json"
    ],
    "readers": [
      "CanonicalPackSetExport",
      "RuntimeContentBundleBuilder"
    ],
    "rebuildPolicy": "rebuild",
    "validationMode": "generated-json",
    "validators": [
      "CanonicalPackSetExport"
    ],
    "versionLocator": "json:$.schemaVersion",
    "writers": [
      "CanonicalPackSetExport"
    ],
