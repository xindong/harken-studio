{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "schemaVersion": {
      "type": "integer"
    },
    "guid": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "guid": {
          "$ref": "#/$defs/guid"
        }
      },
      "required": [
        "name",
        "guid"
      ]
    },
    "waveform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "soundGuid": {
          "$ref": "#/$defs/guid"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.+\\.vkd$"
        },
        "trimStartFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740992
        },
        "trimEndFrame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740992
        }
      },
      "required": [
        "soundGuid",
        "file",
        "trimStartFrame",
        "trimEndFrame"
      ]
    },
    "packMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packStableId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "guid": {
                "$ref": "#/$defs/guid"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "Action",
                  "Sound",
                  "Container",
                  "Track",
                  "Segment",
                  "Layer",
                  "Variable",
                  "Attenuation",
                  "Bus"
                ]
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "guid",
              "name",
              "type",
              "path"
            ]
          }
        }
      },
      "required": [
        "packStableId",
        "platform",
        "language",
        "objects"
      ]
    },
    "projectData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "projectGuid": {
          "$ref": "#/$defs/guid"
        },
        "projectName": {
          "type": "string",
          "minLength": 1
        },
        "studioVersion": {
          "type": "string",
          "minLength": 1
        },
        "studioSchemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "guid": {
                "$ref": "#/$defs/guid"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "basePlatform": {
                "type": "string",
                "enum": [
                  "Windows",
                  "macOS",
                  "Linux",
                  "Android",
                  "iOS"
                ]
              }
            },
            "required": [
              "guid",
              "name",
              "basePlatform"
            ]
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![Ss][Ff][Xx]$).+$"
          }
        }
      },
      "required": [
        "schemaVersion",
        "projectGuid",
        "projectName",
        "studioVersion",
        "studioSchemaVersion",
        "platforms",
        "languages"
      ]
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "guid": {
          "$ref": "#/$defs/guid"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      },
      "required": [
        "name",
        "guid",
        "labels"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/projectData"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "guid": {
          "$ref": "#/$defs/guid"
        },
        "waveforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waveform"
          }
        },
        "metadata": {
          "$ref": "#/$defs/packMetadata"
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "guid"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          }
        },
        "waveforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waveform"
          }
        },
        "metadata": {
          "$ref": "#/$defs/packMetadata"
        }
      },
      "required": [
        "schemaVersion",
        "variables"
      ]
    }
  ],
  "x-harken-format": {
    "classification": "derived",
    "formatId": "generated.pack-companion",
    "pathPatterns": [
      "Project.json",
      "**/Init.json",
      "**/*.json"
    ],
    "readers": [
      "CanonicalPackSetExport",
      "RuntimeContentBundleBuilder"
    ],
    "rebuildPolicy": "rebuild",
    "validationMode": "generated-json",
    "validators": [
      "CanonicalPackSetExport"
    ],
    "versionLocator": "json:$.schemaVersion",
    "writers": [
      "CanonicalPackSetExport"
    ],
    "binaryLayout": {
      "byteOrder": "little",
      "constants": {
        "busDefinitionDownmixCoefficientCount": 64
      },
      "kinds": [
        {
          "name": "bus",
          "id": 2,
          "vintage": 6,
          "record": "bus"
        },
        {
          "name": "busSend",
          "id": 3,
          "vintage": 2,
          "record": "busSend"
        },
        {
          "name": "busDefinitionSnapshot",
          "id": 24,
          "vintage": 2,
          "record": "busDefinitionSnapshotHeader"
        }
      ],
      "records": {
        "bus": {
          "mode": "fixed",
          "fields": [
            {
              "name": "busId",
              "type": "id"
            },
            {
              "name": "parentBusId",
              "type": "id"
            },
            {
              "name": "volume",
              "type": "f32"
            },
            {
              "name": "outputBusVolume",
              "type": "f32"
            }
          ]
        },
        "busSend": {
          "mode": "fixed",
          "fields": [
            {
              "name": "fromBusId",
              "type": "id"
            },
            {
              "name": "toBusId",
              "type": "id"
            },
            {
              "name": "levelDb",
              "type": "f32"
            },
            {
              "name": "reserved0",
              "type": "u32",
              "reserved": true
            }
          ]
        },
        "busDefinitionSnapshotHeader": {
          "mode": "fixed",
          "fields": [
            {
              "name": "schemaVersion",
              "type": "u32"
            },
            {
              "name": "storageModelVersion",
              "type": "u32"
            },
            {
              "name": "headerBytes",
              "type": "u32"
            },
            {
              "name": "publicationCapabilityVintage",
              "type": "u32"
            },
            {
              "name": "contentGeneration",
              "type": "u64"
            },
            {
              "name": "publishedBusFingerprint",
              "type": "u64"
            },
            {
              "name": "busCount",
              "type": "u32"
            },
            {
              "name": "sendCount",
              "type": "u32"
            },
            {
              "name": "effectCount",
              "type": "u32"
            },
            {
              "name": "effectParameterCount",
              "type": "u32"
            },
            {
              "name": "downmixCount",
              "type": "u32"
            },
            {
              "name": "coefficientCount",
              "type": "u32"
            },
            {
              "name": "busOffset",
              "type": "u64"
            },
            {
              "name": "sendOffset",
              "type": "u64"
            },
            {
              "name": "effectOffset",
              "type": "u64"
            },
            {
              "name": "effectParameterOffset",
              "type": "u64"
            },
            {
              "name": "downmixOffset",
              "type": "u64"
            },
            {
              "name": "coefficientOffset",
              "type": "u64"
            },
            {
              "name": "payloadBytes",
              "type": "u64"
            },
            {
              "name": "checksum",
              "type": "u64"
            },
            {
              "name": "compileTargetProfileFingerprint",
              "type": "u64"
            },
            {
              "name": "profileVintage",
              "type": "u32"
            },
            {
              "name": "renderSampleRateHz",
              "type": "u32"
            },
            {
              "name": "mixLayout",
              "type": "u32"
            },
            {
              "name": "deviceLayout",
              "type": "u32"
            },
            {
              "name": "runtimeCapabilityMask",
              "type": "u64"
            },
            {
              "name": "reserved0",
              "type": "u64"
            },
            {
              "name": "busRowBytes",
              "type": "u32"
            },
            {
              "name": "sendRowBytes",
              "type": "u32"
            },
            {
              "name": "downmixRowBytes",
              "type": "u32"
            },
            {
              "name": "coefficientRowBytes",
              "type": "u32"
            },
            {
              "name": "reserved1",
              "type": "u64"
            }
          ]
        },
        "busDefinitionBus": {
          "mode": "fixed",
          "fields": [
            {
              "name": "busId",
              "type": "id"
            },
            {
              "name": "parentId",
              "type": "id"
            },
            {
              "name": "feedsFirstOrdinal",
              "type": "u32"
            },
            {
              "name": "faderDb",
              "type": "f32"
            },
            {
              "name": "outputBusVolumeDb",
              "type": "f32"
            },
            {
              "name": "faderAfterSlot",
              "type": "u32"
            },
            {
              "name": "outputLayout",
              "type": "u32"
            },
            {
              "name": "effectFirst",
              "type": "u32"
            },
            {
              "name": "effectCount",
              "type": "u32"
            },
            {
              "name": "downmixFirst",
              "type": "u32"
            },
            {
              "name": "downmixCount",
              "type": "u32"
            },
            {
              "name": "reserved0",
              "type": "u32",
              "reserved": true
            }
          ]
        },
        "busDefinitionSend": {
          "mode": "fixed",
          "fields": [
            {
              "name": "source",
              "type": "id"
            },
            {
              "name": "target",
              "type": "id"
            },
            {
              "name": "levelDb",
              "type": "f32"
            },
            {
              "name": "reserved0",
              "type": "u32",
              "reserved": true
            },
            {
              "name": "reserved1",
              "type": "u64",
              "reserved": true
            }
          ]
        },
        "busDefinitionDownmix": {
          "mode": "fixed",
          "fields": [
            {
              "name": "busId",
              "type": "id"
            },
            {
              "name": "sourceLayout",
              "type": "u32"
            },
            {
              "name": "destinationLayout",
              "type": "u32"
            },
            {
              "name": "coefficientFirst",
              "type": "u32"
            },
            {
              "name": "coefficientCount",
              "type": "u32"
            },
            {
              "name": "reserved0",
              "type": "u64",
              "reserved": true
            }
          ]
        },
        "busDefinitionCoefficient": {
          "mode": "fixed",
          "fields": [
            {
              "name": "value",
              "type": "f32"
            }
          ]
        }
      }
    }
  }
}
