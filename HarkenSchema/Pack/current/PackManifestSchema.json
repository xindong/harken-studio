{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "guid": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "guid": {
          "$ref": "#/$defs/guid"
        }
      },
      "required": [
        "name",
        "guid"
      ]
    },
    "waveform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "soundGuid": {
          "$ref": "#/$defs/guid"
        },
        "sourceEntryGuid": {
          "$ref": "#/$defs/guid"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.+\\.vkd$"
        },
        "trimStartFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740992
        },
        "trimEndFrame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740992
        }
      },
      "required": [
        "soundGuid",
        "sourceEntryGuid",
        "file",
        "trimStartFrame",
        "trimEndFrame"
      ]
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "guid": {
          "$ref": "#/$defs/guid"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      },
      "required": [
        "name",
        "guid",
        "labels"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "guid": {
          "$ref": "#/$defs/guid"
        },
        "waveforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waveform"
          }
        }
      },
      "required": [
        "name",
        "guid"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          }
        },
        "waveforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waveform"
          }
        }
      },
      "required": [
        "variables"
      ]
    }
  ],
  "x-harken-format": {
    "classification": "derived",
    "formatId": "generated.pack-companion",
    "pathPatterns": [
      "**/Init.json",
      "**/*.json"
    ],
    "readers": [
      "CanonicalPackSetExport",
      "RuntimeContentBundleBuilder"
    ],
    "rebuildPolicy": "rebuild",
    "validationMode": "generated-json",
    "validators": [
      "CanonicalPackSetExport"
    ],
    "versionLocator": "reader:pack-companion",
    "writers": [
      "CanonicalPackSetExport"
    ]
  }
}
