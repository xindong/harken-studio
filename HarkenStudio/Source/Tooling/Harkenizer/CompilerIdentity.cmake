set(identity "")
foreach(archive IN LISTS COMPILER_ARCHIVES)
    file(SHA256 "${archive}" digest)
    string(APPEND identity "${digest}\n")
endforeach()
string(SHA256 identity "${identity}")
set(content "namespace Harkenizer { const char* ${IDENTITY_FUNCTION}() { return \"${identity}\"; } }\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
    if(existing STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
