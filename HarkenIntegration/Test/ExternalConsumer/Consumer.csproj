<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Harken.ExternalConsumer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Harken.Core"><HintPath>$(HarkenCoreAssembly)</HintPath></Reference>
    <Compile Include="$(ConsumerSource)" />
    <Compile Include="$(RemoteContractSource)" Condition="'$(RemoteContractSource)' != ''" />
  </ItemGroup>
</Project>
