<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone runner for the C# binding's ABI, coordinate, and zero-GC gates.
    No NuGet dependencies,
    so it builds offline from the .NET SDK alone. Run it with:
    dotnet run (project HarkenIntegration/Test/ContractTest) — see this folder's README.

    LangVersion is pinned to 9.0 (the Unity 2022.3 LTS C# level) so a
    successful build here also proves the generated + managed API sources are
    Unity-2022.3 language-compatible (it does not, and cannot, prove the IL2CPP
    AOT toolchain build; that stays a Unity/device dependency).

    It compiles the SAME generated + managed API sources the Unity package ships (single
    source, no copy).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HarkenAbiFidelity</AssemblyName>
    <RootNamespace>Harken.Test</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);HARKEN_NATIVE_DEVELOPMENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The binding under test: the exact generated + hand-written managed API sources
         the UPM package ships. -->
    <Compile Include="..\..\..\HarkenIntegration\Unity\Harken\Runtime\Generated\**\*.cs" />
    <Compile Include="..\..\..\HarkenIntegration\Unity\Harken\Runtime\API\**\*.cs" />
    <Compile Include="..\..\..\HarkenIntegration\Unity\Harken\Runtime\Unity\UnityCoordinates.cs" />
    <!-- The harness itself. -->
    <Compile Include="Program.cs" />
    <Compile Include="VariableApiContract.cs" />
    <Compile Include="RemoteCommunicationContract.cs" />
    <Compile Include="RepositoryPublicationContract.cs" />
    <Compile Include="CompanionVersionContract.cs" />
  </ItemGroup>

</Project>
