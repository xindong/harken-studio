{
  "schema_version": 1,
  "note": "Visibility of every generated managed symbol, and the native contracts excluded from the managed projection.",
  "groups": {
    "native-binding": {
      "audience": "internal",
      "disposition": "move-internal",
      "rationale": "The full P/Invoke projection is a managed implementation detail, including public constants and overloads.",
      "consumer_contract": "HarkenNative generated by generate_binding.py; Harken.Unity and Harken.Unity.Editor already have precise friend access."
    },
    "runtime-internals": {
      "audience": "internal",
      "disposition": "move-internal",
      "rationale": "Managed coordination, counters, test hooks and utility implementation are not game contracts.",
      "consumer_contract": "VariableGameplay, VariableCatalogGuard, Utf8, generated ABI checker and internal integration helpers; preserve their existing internal consumers."
    },
    "required-types": {
      "audience": "host-integration",
      "disposition": "supported",
      "rationale": "Keep public types needed by supported wrappers, delegates and their transitive data layout.",
      "consumer_contract": "Generated Vn result/configuration/notification/action/variable/resource types and enum vocabulary needed by accepted native/managed contracts."
    },
    "tool-types": {
      "audience": "tooling",
      "disposition": "move-internal",
      "rationale": "Types used only by the complete tool ABI are not automatically public game DTOs.",
      "consumer_contract": "Full native declarations/wire table remain authoritative; U2 retains required public type closure. VnConstants is classified per member: Monitor/Snapshot formats and limits, effect/curve capacities, staged Voice install and internal variable-batch capacity remain tool vocabulary."
    }
  },
