    HARKEN_SETUP_STAGING_SECURITY_FAILED "The installer staging area could not be secured."
    HARKEN_SETUP_STAGING_CREATE_FAILED "The installer staging area could not be created."
    HARKEN_SETUP_STAGING_LOCK_FAILED "The installer staging area could not be locked."
    HARKEN_SETUP_PAYLOAD_WRITE_FAILED "The installer payload could not be staged."
    HARKEN_SETUP_SYSTEM_UNAVAILABLE "The Windows system directory is unavailable."
    HARKEN_SETUP_LAUNCH_FAILED "Windows Installer could not be started."
    HARKEN_SETUP_ELEVATION_FAILED "The installer could not obtain administrator privileges."
END

