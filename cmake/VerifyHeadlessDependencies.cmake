include_guard(GLOBAL)

function(harken_verify_headless_dependencies)
    foreach(root IN LISTS ARGN)
        if(NOT TARGET "${root}")
            message(FATAL_ERROR "Cannot verify unknown headless target: ${root}")
        endif()

        set(pending "${root}")
        set(visited)
        set(path_${root} "${root}")
        while(pending)
            list(POP_FRONT pending current)
            if(current IN_LIST visited)
                continue()
            endif()
            list(APPEND visited "${current}")

            get_target_property(alias "${current}" ALIASED_TARGET)
            if(alias)
                set(dependencies "${alias}")
            else()
                set(dependencies)
                foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
                    get_target_property(links "${current}" "${property}")
                    if(links)
                        list(APPEND dependencies ${links})
                    endif()
                endforeach()
            endif()

            foreach(dependency IN LISTS dependencies)
                string(REGEX MATCHALL
                    "[A-Za-z0-9_][A-Za-z0-9_.+-]*(::[A-Za-z0-9_][A-Za-z0-9_.+-]*)*"
                    tokens "${dependency}")
                foreach(token IN LISTS tokens)
                    if(token MATCHES "^(Qt[0-9]*::|libQt[0-9]*|Qt[0-9]*)(Gui|Widgets|OpenGL[A-Za-z0-9]*|Svg[A-Za-z0-9]*|Quick[A-Za-z0-9]*|PrintSupport|Charts|Graphs|DataVisualization|3D[A-Za-z0-9]*|Pdf[A-Za-z0-9]*)(Private)?(d)?([.].*)?$")
                        message(FATAL_ERROR
                            "Headless dependency violation: ${path_${current}} -> ${token}")
                    endif()
                    if(TARGET "${token}" AND NOT token IN_LIST visited)
                        if(NOT token IN_LIST pending)
                            set(path_${token} "${path_${current}} -> ${token}")
                            list(APPEND pending "${token}")
                        endif()
                    endif()
                endforeach()
            endforeach()
        endwhile()
    endforeach()
endfunction()
